<%# ─── Users List Page ──────────────────────────────────────────────────── %>
<div class="max-w-6xl mx-auto px-4 py-8">
  <%# Header ─────────────────────────────────────────────────────────────── %>
  <div class="mb-10">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Community Sellers</h1>
    <p class="text-lg text-gray-600">Browse sellers and explore their listings</p>
  </div>

  <%# Users Grid ───────────────────────────────────────────────────────────── %>
  <% if @users.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @users.each do |user| %>
        <%= link_to user_path(user), class: "group" do %>
          <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden h-full flex flex-col">
            <%# Avatar Section ─────────────────────────────────────────────── %>
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 flex justify-center">
              <% if user.avatar.attached? && user.avatar.blob.persisted? %>
                <%= image_tag url_for(user.avatar),
                      alt: "#{user.name} avatar",
                      class: "w-24 h-24 rounded-full object-cover border-4 border-white shadow-md" %>
              <% else %>
                <div class="w-24 h-24 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-white text-3xl font-bold border-4 border-white shadow-md">
                  <%= user.name.first.upcase %>
                </div>
              <% end %>
            </div>

            <%# User Info ──────────────────────────────────────────────────── %>
            <div class="p-5 flex-1 flex flex-col">
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition mb-1">
                <%= user.name %>
              </h3>
              <p class="text-xs text-gray-500 mb-4">
                Joined <%= user.created_at.strftime("%b %Y") %>
              </p>

              <%# Stats ──────────────────────────────────────────────────── %>
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="bg-gray-50 rounded-lg p-3 text-center">
                  <div class="text-lg font-bold text-gray-900">
                    <%= user.products.count %>
                  </div>
                  <div class="text-xs text-gray-600">Items Listed</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-3 text-center">
                  <div class="text-lg font-bold text-gray-900">
                    <%= user.sold_count %>
                  </div>
                  <div class="text-xs text-gray-600">Sold</div>
                </div>
              </div>

              <%# Reviews ────────────────────────────────────────────────── %>
              <div class="flex items-center gap-2 mb-4">
                <div class="flex text-yellow-400">
                  <% 5.times do |i| %>
                    <svg class="w-4 h-4 <%= i < user.positive_reviews_count ? 'fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                    </svg>
                  <% end %>
                </div>
                <span class="text-sm text-gray-600">
                  (<%= user.positive_reviews_count %> reviews)
                </span>
              </div>

              <%# CTA Button ──────────────────────────────────────────────── %>
              <button class="mt-auto w-full py-2 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition font-medium text-sm">
                View Profile
              </button>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# Empty State ────────────────────────────────────────────────────────── %>
    <div class="text-center py-20">
      <div class="text-6xl mb-4">👥</div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">No sellers yet</h2>
      <p class="text-gray-600 mb-6">Check back soon for amazing deals from community sellers!</p>
      <% if logged_in? %>
        <%= link_to "Start Selling", new_listing_path, class: "inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition" %>
      <% else %>
        <%= link_to "Sign Up to Sell", new_user_path, class: "inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition" %>
      <% end %>
    </div>
  <% end %>
</div>
