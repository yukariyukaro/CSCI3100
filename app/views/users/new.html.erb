<div class="max-w-md mx-auto mt-10 p-6 bg-white dark:bg-base-200 rounded-lg shadow-md border border-gray-100 dark:border-base-300">
  <h1 class="text-3xl font-bold text-center mb-2">Sign Up</h1>
  <p class="text-gray-500 dark:text-base-content/60 text-center mb-8">Create your CUHK Marketplace account.</p>

  <%= form_with model: @user, class: "space-y-5" do |form| %>
    <%= render "shared/error_messages", user: @user %>
    <div>
      <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 dark:text-base-content mb-1" %>
      <%= form.text_field :name, required: true, class: "w-full px-4 py-2 border border-gray-300 dark:border-base-300 dark:bg-base-300 dark:text-base-content rounded-md focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    
    <div>
      <%= form.label :email, "Email", class: "block text-sm font-medium text-gray-700 dark:text-base-content mb-1" %>
      <%= form.email_field :email, required: true, class: "w-full px-4 py-2 border border-gray-300 dark:border-base-300 dark:bg-base-300 dark:text-base-content rounded-md focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    
    <div>
      <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 dark:text-base-content mb-1" %>
      <%= form.password_field :password, required: true, class: "w-full px-4 py-2 border border-gray-300 dark:border-base-300 dark:bg-base-300 dark:text-base-content rounded-md focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    
    <div>
      <%= form.label :password_confirmation, "Password confirmation", class: "block text-sm font-medium text-gray-700 dark:text-base-content mb-1" %>
      <%= form.password_field :password_confirmation, required: true, class: "w-full px-4 py-2 border border-gray-300 dark:border-base-300 dark:bg-base-300 dark:text-base-content rounded-md focus:ring-blue-500 focus:border-blue-500" %>
    </div>
    
    <div class="pt-2">
      <%= form.submit "Create Account", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-gray-600 dark:text-base-content/60">
    Already have an account?
    <%= link_to "Go to login", new_session_path, class: "font-medium text-blue-600 hover:text-blue-500 dark:text-primary dark:hover:text-primary/80" %>
  </p>
</div>
