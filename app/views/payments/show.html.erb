<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Payment #<%= @payment.id %></h1>
    <%= link_to "Back", community_payments_path(community_slug: Current.community.slug), class: "btn btn-sm btn-outline" %>
  </div>

  <div class="card bg-white border border-base-200 rounded-xl">
    <div class="card-body">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-sm text-gray-500">Product</div>
          <div class="font-semibold text-gray-900"><%= @payment.product_transaction.product.name %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Amount</div>
          <div class="font-semibold text-gray-900"><%= number_to_currency(@payment.amount) %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Status</div>
          <div class="font-semibold text-gray-900"><%= @payment.status %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Provider</div>
          <div class="font-semibold text-gray-900"><%= @payment.provider %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Reference</div>
          <div class="font-mono text-sm text-gray-900 break-all"><%= @payment.provider_reference.presence || "-" %></div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Error</div>
          <div class="text-sm text-gray-900 break-all"><%= @payment.error_details.presence || "-" %></div>
        </div>
      </div>
    </div>
  </div>
</div>
