<%# ─── Your Listings & Inventory ─────────────────────────────────────────── %>
<div class="max-w-5xl mx-auto px-4 py-10">

  <%# ── Page header ── %>
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Your Listings &amp; Inventory</h1>
      <p class="text-gray-500 mt-1">Manage the products you have published for sale.</p>
    </div>
    <%= link_to new_listing_path,
          class: "btn btn-primary gap-2",
          data: { testid: "publish-new-product-btn" } do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Publish New Product
    <% end %>
  </div>

  <%# ── Flash messages ── %>
  <% if notice.present? %>
    <div class="alert alert-success mb-6" role="alert">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <%# ── Your Published Products ── %>
  <section>
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Your Published Products</h2>

    <% user_products = current_user.products.order(created_at: :desc) %>

    <% if user_products.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% user_products.each do |product| %>
          <div class="card bg-base-100 shadow-md hover:shadow-lg transition border border-base-200">
            <% if product.image.attached? %>
              <figure class="h-48 overflow-hidden">
                <%= image_tag url_for(product.image), alt: product.name,
                      class: "w-full h-full object-cover" %>
              </figure>
            <% else %>
              <div class="h-48 bg-gray-100 flex items-center justify-center text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            <% end %>
            <div class="card-body p-4">
              <h3 class="card-title text-base font-semibold text-gray-900">
                <%= product.name %>
              </h3>
              <p class="text-sm text-gray-500"><%= truncate(product.description, length: 80) %></p>
              <div class="flex justify-between items-center mt-3">
                <span class="text-primary font-bold">HK$<%= number_with_precision(product.price, precision: 2) %></span>
                <span class="badge badge-sm
                  <%= case product.sale_status
                      when 'active'  then 'badge-success'
                      when 'pending' then 'badge-warning'
                      when 'sold'    then 'badge-ghost'
                      else 'badge-ghost'
                      end %>">
                  <%= product.sale_status.capitalize %>
                </span>
              </div>
              <div class="card-actions justify-end mt-2">
                <%= link_to "View", product_path(product), class: "btn btn-sm btn-outline" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-gray-50 rounded-xl border border-dashed border-gray-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
        <p class="text-gray-500 text-lg mb-2">You haven't published any products yet.</p>
        <p class="text-gray-400 text-sm mb-6">Start selling by publishing your first item!</p>
        <%= link_to "Publish Your First Product", new_listing_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </section>
</div>
