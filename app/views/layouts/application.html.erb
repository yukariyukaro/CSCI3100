<!DOCTYPE html>
<html>
  <head>
    <title>CuhkMarketplace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <% if respond_to?(:tailwind_css_tag) %>
      <%= tailwind_css_tag "application", "data-turbo-track": "reload" %>
    <% elsif Rails.application.assets&.find_asset("tailwind.css") || Rails.application.assets_manifest&.assets&.key?("tailwind.css") %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice.present? %>
      <p><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p><%= alert %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
