<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title>CuhkMarketplace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Anti-flash: read saved theme before first paint to avoid white flash %>
    <script>
      (function() {
        var saved = localStorage.getItem('theme');
        var preferred = (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : (saved || 'light');
        document.documentElement.setAttribute('data-theme', preferred);
      })();
    </script>
    
    <% if respond_to?(:tailwind_css_tag) %>
      <%= tailwind_css_tag "application", "data-turbo-track": "reload" %>
    <% elsif Rails.application.assets&.find_asset("tailwind.css") || Rails.application.assets_manifest&.assets&.key?("tailwind.css") %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-100 text-base-content min-h-screen transition-colors duration-300">
    <%= render "shared/navigation_bar" %>
    <%= render "shared/flash_messages" %>
    <main class="min-h-screen bg-base-100">
      <%= yield %>
    </main>
  </body>
</html>
