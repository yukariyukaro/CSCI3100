<h1>Products</h1>
<p>Second-hand products list.</p>

<div class="search-container" style="margin-bottom: 20px; position: relative;" data-controller="autocomplete" data-autocomplete-url-value="/products/autocomplete">
  <%= form_with url: products_path, method: :get, local: true do |form| %>
    <%= form.text_field :query, 
          placeholder: "Search for items (min 2 chars)...", 
          value: params[:query],
          autocomplete: "off",
          data: { 
            autocomplete_target: "input", 
            action: "input->autocomplete#onInput keydown->autocomplete#onKeydown" 
          },
          role: "combobox",
          "aria-autocomplete": "list"
    %>
    
    <%= form.label :sort, "Sort by:" %>
    <%= form.select :sort, 
          options_for_select([
            ['Relevance', 'relevance'], 
            ['Time (Newest First)', 'time_desc'],
            ['Price (Low to High)', 'price_asc'],
            ['Price (High to Low)', 'price_desc']
          ], params[:sort]) %>
          
    <%= form.submit "Search" %>
    <span data-autocomplete-target="loading" class="hidden" style="margin-left: 10px; font-size: 0.9em; color: #666;">Loading...</span>
  <% end %>
  <ul data-autocomplete-target="results" class="autocomplete-results hidden"></ul>
</div>

<% if @products.any? %>
  <ul>
    <% @products.each do |product| %>
      <li>
        <%= link_to product.name, product_path(product) %>
        - <%= number_to_currency(product.price) %> (<%= product.condition %>)
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No products found.</p>
<% end %>

<div data-controller="products-placeholder"></div>
