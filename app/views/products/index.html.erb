<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-base-content">全部商品</h1>
      <p class="text-base-content/60 mt-1">发现二手好物</p>
    </div>
  </div>

  <div class="bg-base-200 p-4 rounded-xl mb-8">
    <!-- Search Form -->
    <%= form_with url: community_products_path(community_slug: Current.community.slug), method: :get, local: true, class: "flex flex-col md:flex-row gap-4 relative", data: { controller: "autocomplete", autocomplete_url_value: autocomplete_community_products_path(community_slug: Current.community.slug) } do |form| %>
      <div class="flex-1 relative">
        <%= form.text_field :query, 
              placeholder: "搜索商品 (至少2个字符)...", 
              value: params[:query],
              autocomplete: "off",
              class: "input input-bordered w-full bg-white text-gray-900",
              data: { 
                autocomplete_target: "input", 
                action: "input->autocomplete#onInput keydown->autocomplete#onKeydown" 
              },
              role: "combobox",
              "aria-autocomplete": "list"
        %>
        <span data-autocomplete-target="loading" class="hidden absolute right-3 top-3 loading loading-spinner loading-sm text-primary"></span>
        <!-- Search autocomplete results will be placed here -->
        <ul data-autocomplete-target="results" class="autocomplete-results hidden absolute z-[100] bg-white/70 backdrop-blur-md shadow-xl rounded-box w-full mt-1 max-h-60 overflow-y-auto text-gray-900"></ul>
      </div>
      
      <div class="flex gap-2">
        <%= form.select :sort, 
              options_for_select([
                ['相关度优先', 'relevance'], 
                ['最新发布', 'time_desc'],
                ['价格从低到高', 'price_asc'],
                ['价格从高到低', 'price_desc']
              ], params[:sort]), {}, class: "select select-bordered bg-white text-gray-900" %>
              
        <%= form.submit "搜索", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <% if @products.any? %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @products.each do |product| %>
        <% cache product do %>
          <%= link_to community_product_path(community_slug: product.community.slug, id: product), class: "card bg-base-100 shadow-sm border border-base-200 hover:shadow-lg transition-all duration-300 hover:-translate-y-1 group relative #{'opacity-75' if product.sold? || product.offlined?}", "aria-label": "View details for #{product.name}" do %>
            <div class="absolute top-3 right-3 z-10">
              <% case product.sale_status %>
              <% when "active" %>
                <span class="badge badge-success">Available</span>
              <% when "pending" %>
                <span class="badge badge-warning">Reserved</span>
              <% when "sold" %>
                <span class="badge badge-error">Sold</span>
              <% when "offlined" %>
                <span class="badge badge-neutral">Offlined</span>
              <% end %>
            </div>
            <figure class="aspect-square bg-base-200 w-full overflow-hidden">
              <% if product.image.attached? && product.image.blob.persisted? %>
                <%= image_tag product.image.variant(:thumb),
                      alt: product.name,
                      class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
              <% else %>
                <%= image_tag "default-product.svg",
                      alt: product.name,
                      class: "w-full h-full object-cover opacity-70 group-hover:scale-105 transition-transform duration-500" %>
              <% end %>
            </figure>
            <div class="card-body p-4">
              <h2 class="card-title text-base text-base-content line-clamp-1"><%= product.name %></h2>
              <div class="flex items-center gap-2 mt-1 mb-2">
                <div class="badge <%= condition_badge_class(product.condition) %> badge-sm"><%= product.condition %></div>
                <div class="badge badge-outline badge-sm"><%= product.community.abbreviation %></div>
              </div>
              <div class="mt-auto pt-2 flex items-center justify-between">
                <span class="text-xl text-primary font-bold"><%= number_to_currency(product.price) %></span>
                <button class="btn btn-primary btn-sm btn-circle opacity-0 group-hover:opacity-100 transition-opacity" aria-label="View product">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </button>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-base-200 rounded-xl">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <h3 class="text-xl font-bold text-base-content">未找到相关商品</h3>
      <p class="text-base-content/60 mt-2">尝试更换关键词或筛选条件</p>
    </div>
  <% end %>

  <div data-controller="products-placeholder"></div>
</div>
