<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Left: Image Gallery -->
    <div class="lg:w-1/2 flex flex-col gap-4">
      <div class="aspect-square bg-base-200 rounded-xl overflow-hidden flex items-center justify-center border border-base-300">
        <% if @product.image.attached? && @product.image.blob.persisted? %>
          <%= image_tag url_for(@product.image),
                alt: @product.name,
                class: "w-full h-full object-cover" %>
        <% else %>
          <%= image_tag "default-product.svg",
                alt: @product.name,
                class: "w-full h-full object-cover opacity-70" %>
        <% end %>
      </div>
      <div class="flex gap-2 overflow-x-auto pb-2">
        <div class="w-20 h-20 bg-base-200 rounded-lg shrink-0 border border-base-300"></div>
        <div class="w-20 h-20 bg-base-200 rounded-lg shrink-0 border border-base-300"></div>
        <div class="w-20 h-20 bg-base-200 rounded-lg shrink-0 border border-base-300"></div>
        <div class="w-20 h-20 bg-base-200 rounded-lg shrink-0 border border-base-300"></div>
      </div>
    </div>

    <!-- Right: Info & Actions -->
    <div class="lg:w-1/2 flex flex-col gap-6">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="badge badge-secondary"><%= @product.condition %></span>
          <% case @product.sale_status %>
          <% when "active" %>
            <span class="badge badge-success">Available</span>
          <% when "pending" %>
            <span class="badge badge-warning">Reserved</span>
          <% when "sold" %>
            <span class="badge badge-error">Sold</span>
          <% end %>
          <span class="text-sm text-gray-500">ID: <%= @product.id %></span>
        </div>
        <h1 class="text-3xl font-bold mb-4 text-gray-900"><%= @product.name %></h1>
        <p class="text-3xl text-primary font-bold"><%= number_to_currency(@product.price) %></p>
      </div>

      <!-- AI Summary Card -->
      <div class="my-2">
        <% case @product.ai_summary_status %>
        <% when 'completed' %>
          <div class="card bg-base-200 border-l-4 border-primary shadow-sm animate-fade-in">
            <div class="card-body p-4">
              <h3 class="card-title text-primary text-sm flex items-center gap-1 mb-2">
                ✨ AI 智能卖点总结
              </h3>
              <div class="leading-relaxed text-sm text-gray-700">
                <%= simple_format(@product.ai_summary) %>
              </div>
              <span class="text-xs text-gray-400 mt-2 block">自动生成，仅供参考</span>
            </div>
          </div>
        <% when 'generating', nil %>
          <div class="card bg-base-200 border-l-4 border-primary shadow-sm">
            <div class="card-body p-4">
               <h3 class="card-title text-primary text-sm flex items-center gap-1 mb-3">
                <span class="animate-pulse">✨ AI 正在分析卖点...</span>
              </h3>
              <div class="flex flex-col gap-2">
                <div class="skeleton h-3 w-full"></div>
                <div class="skeleton h-3 w-5/6"></div>
                <div class="skeleton h-3 w-4/6"></div>
              </div>
            </div>
          </div>
        <% when 'failed', 'skipped' %>
          <!-- 优雅隐藏 -->
          <div class="hidden"></div>
        <% else %>
          <div class="card bg-base-200 border-l-4 border-primary shadow-sm">
            <div class="card-body p-4">
              <h3 class="card-title text-primary text-sm flex items-center gap-1 mb-3 animate-pulse">
                ✨ 正在唤醒 AI 助手...
              </h3>
              <div class="flex flex-col gap-2">
                <div class="skeleton h-3 w-full"></div>
                <div class="skeleton h-3 w-3/4"></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Description -->
      <div class="mt-2">
        <h2 class="text-lg font-semibold mb-3 text-gray-900">商品描述</h2>
        <div class="leading-relaxed text-gray-700 whitespace-pre-wrap text-sm"><%= @product.description %></div>
      </div>

      <!-- Actions -->
      <% active_tx = @product.active_transaction %>
      <div class="mt-8 pt-6 border-t border-base-200">
        <% if @product.active? %>
          <% if !logged_in? %>
            <%= link_to "登录后预定", new_session_path, class: "btn btn-primary w-full btn-lg text-lg" %>
          <% elsif @product.seller_id.present? && @product.seller_id == current_user.id %>
            <div class="text-sm text-gray-500 italic text-center">This is your listing.</div>
          <% elsif @product.seller_id.blank? %>
            <div class="alert alert-warning">
              <span>该商品暂不可预定。</span>
            </div>
          <% else %>
            <div data-testid="reserve-button">
              <%= button_to "预定 / Reserve", reserve_product_path(@product), method: :post, class: "btn btn-primary w-full btn-lg text-lg" %>
            </div>
          <% end %>
        <% elsif @product.pending? %>
          <div class="alert alert-warning mb-4">
            <span>Under Reservation</span>
          </div>

          <% if logged_in? && @product.seller_id.present? && @product.seller_id == current_user.id %>
            <div class="flex gap-2">
              <%= button_to "标记已售出 / Mark Sold", mark_sold_product_path(@product), method: :patch, class: "btn btn-success flex-1 btn-lg" %>
              <%= button_to "取消预定 / Cancel", cancel_reservation_product_path(@product), method: :delete, class: "btn btn-outline btn-error flex-1 btn-lg" %>
            </div>
          <% elsif logged_in? && active_tx.present? && active_tx.buyer_id == current_user.id %>
            <div class="flex flex-col gap-2">
              <div data-testid="pay-now-button">
                <%= button_to "支付 / Pay now", transaction_payments_path(active_tx), method: :post, class: "btn btn-primary w-full btn-lg" %>
              </div>
              <%= button_to "取消我的预定 / Cancel", cancel_reservation_product_path(@product), method: :delete, class: "btn btn-outline btn-error w-full btn-lg" %>
            </div>
          <% else %>
            <div class="text-sm text-gray-500 text-center">该商品已被预定。</div>
          <% end %>
        <% elsif @product.sold? %>
          <button class="btn btn-disabled w-full btn-lg text-lg" disabled>已售出 / Sold Out</button>
        <% end %>
      </div>

      <% if logged_in? && @product.seller.present? && current_user != @product.seller %>
        <div class="mt-3">
          <% if @conversation %>
            <%= link_to conversation_path(@conversation),
                  class: "btn btn-outline w-full btn-lg text-base-content",
                  data: { testid: "contact-seller" } do %>
              💬 联系卖家 / Contact Seller
            <% end %>
          <% else %>
            <div data-testid="contact-seller">
              <%= button_to conversations_path,
                    params: { conversation: { product_id: @product.id } },
                    class: "btn btn-outline w-full btn-lg text-base-content",
                    form: { data: { turbo: false } } do %>
                💬 联系卖家 / Contact Seller
              <% end %>
            </div>
          <% end %>
        </div>
      <% elsif !logged_in? %>
        <div class="mt-3">
          <%= link_to new_session_path, class: "btn btn-outline w-full btn-lg text-base-content" do %>
            登录后联系卖家 / Login to Contact Seller
          <% end %>
        </div>
      <% end %>

      <div class="mt-2 text-center lg:text-left">
        <%= link_to "← 返回商品列表", products_path, class: "link link-hover text-sm text-gray-500" %>
      </div>
    </div>
  </div>
</div>
